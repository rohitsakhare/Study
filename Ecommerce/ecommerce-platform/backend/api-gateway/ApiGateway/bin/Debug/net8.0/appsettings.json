{
  "Serilog": {
    "MinimumLevel": "Information"
  },

  "Jwt": {
    "Authority": "http://localhost:8080/realms/ecommerce-realm",
    "Audience": "api-gateway",
    "RequireHttpsMetadata": false
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      }
    ]
  },

  "ReverseProxy": {
    "Routes": {

      "users-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/users/{**catch-all}" }]
      },

      "products-read-route": {
        "ClusterId": "product-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/products/{**catch-all}",
          "Methods": ["GET"]
        }
      },

      "products-write-route": {
        "ClusterId": "product-cluster",
        "AuthorizationPolicy": "admin-only",
        "Match": {
          "Path": "/api/products/{**catch-all}",
          "Methods": ["POST", "PUT", "DELETE"]
        }
      },

      "orders-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },

      "payments-route": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },

      "deliveries-route": {
        "ClusterId": "delivery-cluster",
        "AuthorizationPolicy": "delivery-or-admin",
        "Match": { "Path": "/api/deliveries/{**catch-all}" }
      },

      "notifications-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "admin-only",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      }
    },

    "Clusters": {
      "user-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "user-1": { "Address": "http://user-service:5001" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Path": "/health"
          }
        }
      },
      "product-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "product-1": { "Address": "http://product-service:5002" }
        }
      },
      "order-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "order-1": { "Address": "http://order-service:5003" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-1": { "Address": "http://payment-service:5004" }
        }
      },
      "delivery-cluster": {
        "Destinations": {
          "delivery-1": { "Address": "http://delivery-service:5005" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-1": { "Address": "http://notification-service:5006" }
        }
      }
    }
  }
}